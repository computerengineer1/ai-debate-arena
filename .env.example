# ═══════════════════════════════════════════════════════════════════
#  AI DEBATE ARENA — Environment Configuration
#  Copy this file to `.env` and fill in your keys. NEVER commit .env
# ═══════════════════════════════════════════════════════════════════

# ── Groq (LLM brain + optional Orpheus voice) ──────────────────────
# Get a key at https://console.groq.com/keys  — used server-side ONLY.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Primary model for debate generation. Falls back automatically.
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
# Arabic debates can optionally use the ALLaM model (Arabic specialist):
GROQ_MODEL_AR=allam-2-7b

# ── Voice engine ────────────────────────────────────────────────────
# Priority chain, comma separated. First working provider wins.
#   orpheus    → Groq-hosted Orpheus neural speech (EN + AR, emotion
#                tags like [anger]). Requires ONE-TIME terms acceptance:
#                https://console.groq.com/playground?model=canopylabs%2Forpheus-v1-english
#   elevenlabs → Ultra-realistic, 29+ languages. Optional.
#   edge       → Microsoft Edge neural voices. FREE, no key, 16 languages
#                with native accents. (default workhorse)
#   browser    → Client-side Web Speech API. Last-resort fallback.
TTS_PROVIDER_CHAIN=orpheus,elevenlabs,edge

# ── ElevenLabs (optional — highest realism) ────────────────────────
# Get a key at https://elevenlabs.io → Profile → API Keys
ELEVEN_API_KEY=
ELEVEN_MODEL=eleven_multilingual_v2
# Voice IDs per character (VoiceLab). Leave empty to use defaults below.
ELEVEN_VOICE_LOGOS=
ELEVEN_VOICE_PATHOS=
ELEVEN_VOICE_REFEREE=

# ── Groq Orpheus voices (optional) ─────────────────────────────────
ORPHEUS_VOICE_LOGOS=male-01
ORPHEUS_VOICE_PATHOS=male-03
ORPHEUS_VOICE_REFEREE=male-06

# ── Optional infra ──────────────────────────────────────────────────
# Redis for cross-instance TTS/script caching (memory cache used if absent)
REDIS_URL=
# Override the public origin (used in cache keys)
APP_URL=http://localhost:3000

# ── Auth (OAuth logins) ─────────────────────────────────────────────
# Create OAuth clients: console.cloud.google.com (Google), github.com/settings/developers,
# discord.com/developers — callback URL: https://YOUR-DOMAIN/api/auth/callback/<provider>
AUTH_SECRET=generate-a-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Quota/profile storage (free tier is plenty) ────────────────────
# Create at upstash.com → Redis → copy REST URL + token.
# Without it, an in-memory fallback runs (single instance only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Payments (Lemon Squeezy — merchant of record, works worldwide) ─
# lemonsqueezy.com → create products "Orator" ($4.99/mo) & "Legend"
# ($11.99/mo) → copy checkout URLs + variant ids → Webhooks: add
# https://YOUR-DOMAIN/api/billing/webhook with a signing secret.
LS_CHECKOUT_ORATOR=
LS_CHECKOUT_LEGEND=
LS_VARIANT_ORATOR=
LS_VARIANT_LEGEND=
LS_WEBHOOK_SECRET=

# ── Ads (optional — house ads show until configured) ───────────────
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_LANDING=
NEXT_PUBLIC_ADSENSE_SLOT_PROFILE=
NEXT_PUBLIC_ADSENSE_SLOT_VICTORY=
